# ===== AWS 공통 =====
AWS_REGION=ap-northeast-2

# ===== S3 (서울 리전) =====
# 손상 이미지가 저장되는 버킷
S3_BUCKET=container-damage
# 분석 대상 프리픽스 (예: 날짜 폴더). 비워두면 버킷 전체를 스캔
S3_PREFIX=

# ===== SageMaker =====
# 노트북/재분석 실행 인스턴스 타입
SAGEMAKER_INSTANCE_TYPE=ml.t3.medium

# ===== Bedrock Foundation Model =====
# Bedrock 리전 (서울)
BEDROCK_REGION=ap-northeast-2
# 비전(이미지 입력) 지원 모델 ID — Sonnet 4.5 (서울은 apac/global 추론 프로파일 필요)
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0

# ===== 보고서 RAG (Bedrock Knowledge Base, 선택) =====
# 보고서 양식/지침을 색인한 Knowledge Base ID. 비우면 RAG 없이 동작
KNOWLEDGE_BASE_ID=
# 검색해 올 청크 수
KB_MAX_RESULTS=4

# ===== 보고서 자동화 (report_generator Lambda) =====
# 검수 이벤트 테이블 (보고서 메타 업데이트 대상)
DDB_TABLE=InspectionEventTable
# EIR PDF 저장 버킷 (비우면 S3_BUCKET 사용)
REPORT_BUCKET=container-damage
# PDF 키 프리픽스
REPORT_PREFIX=reports/
# PDF 한글 렌더링용 TTF 경로 (예: 번들한 NanumGothic.ttf). 없으면 한글 누락
REPORT_FONT_PATH=

# ===== Risk Score 튜닝 (선택) =====
# 손상 유형별 가중치: 구멍 >= 찌그러짐 > 녹슴
RISK_WEIGHT_HOLE=1.0
RISK_WEIGHT_DENT=0.7
RISK_WEIGHT_RUST=0.35
# HIGH / MEDIUM 판정 임계값 (0~100)
RISK_THRESHOLD_HIGH=66
RISK_THRESHOLD_MEDIUM=33
