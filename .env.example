# ===== AWS 공통 =====
AWS_REGION=ap-northeast-2

# ===== S3 (서울 리전) =====
# 손상 이미지가 저장되는 버킷
S3_BUCKET=container-damage
# 분석 대상 프리픽스 (예: 날짜 폴더). 비워두면 버킷 전체를 스캔
S3_PREFIX=

# ===== SageMaker =====
# 노트북/재분석 실행 인스턴스 타입
SAGEMAKER_INSTANCE_TYPE=ml.t3.medium

# ===== Bedrock Foundation Model =====
# Bedrock 리전 (서울)
BEDROCK_REGION=ap-northeast-2
# 비전(이미지 입력) 지원 모델 ID — Sonnet 4.5 (서울은 apac/global 추론 프로파일 필요)
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0

# 재검수 화질 개선 (Nova Canvas — 서울 미지원)
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
BEDROCK_IMAGE_REGION=us-east-1

# ===== Risk Score 튜닝 (선택) =====
# 손상 유형별 가중치: 구멍 >= 찌그러짐 > 녹슴
RISK_WEIGHT_HOLE=1.0
RISK_WEIGHT_DENT=0.7
RISK_WEIGHT_RUST=0.35
# HIGH / MEDIUM 판정 임계값 (0~100)
RISK_THRESHOLD_HIGH=66
RISK_THRESHOLD_MEDIUM=33
